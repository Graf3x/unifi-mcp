# unifi-mcp settings for docker-compose.yml. Copy to .env and fill in; never commit .env.
# Every value is read from the environment at startup: after changing one, run `docker compose up -d` again.

# --- Container user -----------------------------------------------------------------------------------------------
# Your user and group ids (`id -u`, `id -g`); ./data and ./run must be writable by them.
PUID=1000
PGID=1000

# --- UniFi console ------------------------------------------------------------------------------------------------
# The console's address as the container reaches it. https:// only.
UNIFI_URL=https://192.168.1.1
# The site to use when a tool doesn't name one.
UNIFI_SITE=default
# Network API key: UniFi Network > Settings > Control Plane > Integrations > Create API Key.
UNIFI_API_KEY=
# SHA-256 fingerprint of the console's TLS certificate (64 hex digits, colons allowed). See README for how to read it.
UNIFI_CERT_SHA256=
# Write tools (create/update/delete) exist only when this is exactly "true"; each write still needs a per-call confirm.
UNIFI_ALLOW_WRITES=false

# --- Claude connector (public side) -------------------------------------------------------------------------------
# The public https origin your Cloudflare tunnel serves, e.g. https://unifi.example.com (no path). The connector URL is <this>/mcp.
MCP_PUBLIC_BASE_URL=
# How you sign in when Claude connects: "code" (a one-time code from `docker compose logs unifi-mcp`, nothing else to
# set up) or "google" (Google sign-in; fill in the three GOOGLE values below). The server's own default is google.
MCP_SIGNIN=code
# google only: Google OAuth web client (redirect URI: <MCP_PUBLIC_BASE_URL>/signin-google).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# google only: addresses allowed to sign in, comma separated, e.g. you@example.com. Google must report each as verified.
MCP_ALLOWED_GOOGLE_EMAILS=
# Optional: a fixed token /mcp also accepts, as "Authorization: Bearer <token>" or "X-Api-Key: <token>", for clients that
# send a static header instead of signing in. At least 32 characters: `openssl rand -hex 32`. Leave empty for none.
MCP_ACCESS_TOKEN=
# Wraps the OAuth signing keys in ./data. Generate once with `openssl rand -base64 32` and keep it: a different value
# cannot open the existing keys (the connector then answers 503) until you delete ./data, which disconnects every client.
UNIFI_MCP_DATA_KEY=
# Cloudflare tunnel token (Zero Trust > Networks > Tunnels > your tunnel; the part after --token). Required.
TUNNEL_TOKEN=

# --- Tailnet side (optional) --------------------------------------------------------------------------------------
# Tailscale logins allowed on ./run/mcp.sock when you publish it with `tailscale serve`, comma separated.
# Leave empty if you only use the Claude connector.
MCP_ALLOWED_LOGINS=

# --- Advanced (defaults are right for docker-compose.yml) ---------------------------------------------------------
# Files read when the matching value above is empty (inside the container; mount a ./config folder to use them).
# UNIFI_API_KEY_FILE=/config/unifi-api-key
# UNIFI_CERT_SHA256_FILE=/config/cert-sha256
# MCP_ALLOWED_LOGINS_FILE=/config/allowed-logins
# MCP_ALLOWED_GOOGLE_EMAILS_FILE=/config/allowed-google-emails
# Listeners: Unix sockets by default. TCP is refused except loopback with MCP_ALLOW_LOOPBACK_TCP=true (local development).
# MCP_LISTEN=unix:/run/unifi-mcp/mcp.sock
# MCP_PUBLIC_LISTEN=unix:/run/unifi-mcp/public.sock
# MCP_ALLOW_LOOPBACK_TCP=false
# Where the OAuth store and keys live.
# MCP_DATA_DIR=/data
